{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": { "#shared/*": ["./container/shared/src/*"] }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "container"],
  "references": [{ "path": "./container/shared" }]
}
