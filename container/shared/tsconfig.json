{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2024.String"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".",
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["*.ts"],
  "exclude": ["*.d.ts"]
}
