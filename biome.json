{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!docs",
      "!skills",
      "!community-skills",
      "!tests",
      "!eval-harness/routing/prompting/validation.json",
      "!plugins/laya-router/runtime/routing-calibration.json",
      "!desktop/icon"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Input",
              "Textarea",
              "NativeSelect",
              "Switch",
              "Checkbox",
              "NumberField"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@hybridclaw/shared",
                      "@hybridclaw/shared/**",
                      "**/shared/src/**"
                    ],
                    "message": "@hybridclaw/contracts is the bottom layer: @hybridclaw/shared imports from it, never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
